#include "stdcycles.h"

shader node_diffuse_bsdf(color Color = 0.8,
                         float Roughness = 0.0,
                         float ClosureWeight = 1.0,
                         string method = "oren_nayar",
                         normal Normal = N,
                         output closure color BSDF = 0)
{
  if (method == "burley")
    BSDF = ClosureWeight * materialx_burley_diffuse_bsdf(Normal, Color, Roughness);
  else if (Roughness < 1e-5)
    BSDF = ClosureWeight * Color * diffuse(Normal);
  else
    BSDF = ClosureWeight * oren_nayar_diffuse_bsdf(Normal, clamp(Color, 0.0, 1.0), Roughness);
}
