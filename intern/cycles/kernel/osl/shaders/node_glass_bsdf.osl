#include "node_fresnel.h"
#include "stdcycles.h"

shader node_glass_bsdf(color Color = 0.8,
                       string distribution = "ggx",
                       float Roughness = 0.2,
                       float IOR = 1.45,
                       float AlphaX = -1.0,
                       float AlphaY = -1.0,
                       float Rotation = 0.0,
                       normal Tangent = 0.0,
                       float ThinFilmThickness = 0.0,
                       float ThinFilmIOR = 1.33,
                       normal Normal = N,
                       output closure color BSDF = 0)
{
  color base_color = max(Color, color(0.0));
  float r2 = clamp(Roughness, 0.0, 1.0);
  r2 = r2 * r2;
  float alpha_x = r2, alpha_y = r2;
  vector T = vector(0.0);
  if (AlphaX >= 0.0 && AlphaY >= 0.0) {
    alpha_x = AlphaX;
    alpha_y = AlphaY;
    if (alpha_x != alpha_y) {
      T = normalize(Tangent);
      if (Rotation != 0.0)
        T = rotate(T, Rotation * M_2PI, point(0.0, 0.0, 0.0), Normal);
    }
  }
  float eta = max(IOR, 1e-5);
  float thinfilm_ior = backfacing() ? ThinFilmIOR / eta : ThinFilmIOR;
  eta = backfacing() ? 1.0 / eta : eta;
  color F0 = F0_from_ior(eta);
  color F90 = color(1.0);

  BSDF = generalized_schlick_bsdf(Normal,
                                  T,
                                  base_color,
                                  base_color,
                                  alpha_x,
                                  alpha_y,
                                  F0,
                                  F90,
                                  -eta,
                                  distribution,
                                  "thinfilm_thickness",
                                  ThinFilmThickness,
                                  "thinfilm_ior",
                                  thinfilm_ior);
}
